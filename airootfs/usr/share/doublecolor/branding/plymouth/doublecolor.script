# DoubleColor OS — заставка загрузки и выключения.
# Набор вызовов намеренно минимальный: только то, что точно поддерживается
# скриптовым плагином Plymouth. Никаких обработчиков пароля и сообщений.

Window.SetBackgroundTopColor(0.043, 0.063, 0.125);
Window.SetBackgroundBottomColor(0.075, 0.145, 0.255);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---------- логотип ----------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(screen_x + (screen_w - logo.image.GetWidth()) / 2,
                        screen_y + screen_h * 0.27,
                        10);

# ---------- индикатор (три точки) ----------
dot_image = Image.Text("•", 0.62, 0.82, 1.0);
dot_gap = 46;
dot_x = screen_x + screen_w / 2 - dot_gap;
dot_y = screen_y + screen_h * 0.27 + logo.image.GetHeight() + 30;

dot1.sprite = Sprite(dot_image);
dot1.sprite.SetPosition(dot_x, dot_y, 20);
dot2.sprite = Sprite(dot_image);
dot2.sprite.SetPosition(dot_x + dot_gap, dot_y, 20);
dot3.sprite = Sprite(dot_image);
dot3.sprite.SetPosition(dot_x + dot_gap * 2, dot_y, 20);

phase = 0;

fun refresh_callback ()
  {
    phase = phase + 0.08;
    if (phase > 6.283) phase = 0;
    dot1.sprite.SetOpacity(0.25 + 0.75 * (Math.Cos(phase) + 1) / 2);
    dot2.sprite.SetOpacity(0.25 + 0.75 * (Math.Cos(phase + 2.09) + 1) / 2);
    dot3.sprite.SetOpacity(0.25 + 0.75 * (Math.Cos(phase + 4.19) + 1) / 2);
  }

Plymouth.SetRefreshFunction(refresh_callback);

# ---------- полоса готовности ----------
bar_bg.image = Image("bar_bg.png");
bar_bg.sprite = Sprite(bar_bg.image);
bar_bg.sprite.SetPosition(screen_x + (screen_w - bar_bg.image.GetWidth()) / 2,
                          screen_y + screen_h * 0.72,
                          15);

bar.original = Image("bar.png");
bar.sprite = Sprite(bar.original);
bar.sprite.SetPosition(screen_x + (screen_w - bar.original.GetWidth()) / 2,
                       screen_y + screen_h * 0.72,
                       16);

fun progress_callback (duration, value)
  {
    width = Math.Int(bar.original.GetWidth() * value);
    if (width > 2)
      {
        bar.image = bar.original.Scale(width, bar.original.GetHeight());
        bar.sprite.SetImage(bar.image);
      }
  }

Plymouth.SetBootProgressFunction(progress_callback);

# ---------- окно состояния справа ----------
panel.image = Image("panel.png");
panel.x = screen_x + screen_w - panel.image.GetWidth() - 36;
panel.y = screen_y + screen_h - panel.image.GetHeight() - 36;
panel.sprite = Sprite(panel.image);
panel.sprite.SetPosition(panel.x, panel.y, 40);
panel.sprite.SetOpacity(0.9);

status.sprite = Sprite();
status.sprite.SetOpacity(0);

fun set_status (text)
  {
    status.image = Image.Text(text, 0.82, 0.90, 1.0);
    status.sprite.SetImage(status.image);
    status.sprite.SetOpacity(1);
    status.sprite.SetPosition(panel.x + 18,
                              panel.y + (panel.image.GetHeight() - status.image.GetHeight()) / 2,
                              41);
  }

Plymouth.SetUpdateStatusFunction(set_status);
